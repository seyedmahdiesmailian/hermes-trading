[Unit]
Description=Hermes Ops Dashboard Bot (read-only Telegram panels)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ai/hermes-trading
ExecStart=/home/ai/hermes-trading/.venv/bin/python /home/ai/hermes-trading/scripts/dashboard_bot.py
Restart=always
RestartSec=10
Nice=10
# b38fix: dashboard_bot.log() appends to logs/dashboard.log itself —
# redirecting stdout to the same file duplicated every line.

[Install]
WantedBy=default.target
