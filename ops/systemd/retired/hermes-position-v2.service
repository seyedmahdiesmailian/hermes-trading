[Unit]
Description=Hermes Position Watchdog V2 (second-by-second trade management)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ai/hermes-trading
Environment="PATH=/home/ai/hermes-trading/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ai/hermes-trading/.venv/bin/python3 /home/ai/hermes-trading/entry_points/daemon_position.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
