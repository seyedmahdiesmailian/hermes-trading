[Unit]
Description=Hermes Position Watchdog (second-by-second trade management)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ai/hermes-trading
EnvironmentFile=/home/ai/hermes-trading/.env
Environment="PYTHONPATH=/home/ai/hermes-trading"
ExecStart=/usr/bin/python3 /home/ai/hermes-trading/position_daemon.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
