# Hermes Trading System — Environment Variables
# Copy this to .env and fill in the values

# Set to 'false' to enable real trading (DANGEROUS)
HERMES_DRY_RUN=true

# Windows Bridge connection
HERMES_WIN_IP=192.168.10.51
HERMES_BRIDGE_URL=http://192.168.10.51:5050

# Telegram notifications (create a bot via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
