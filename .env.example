# Hermes Trading System — Environment Variables
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# On a fresh server, the real values come from the off-box backup
# (Windows C:\HermesBackups\hermes_backup_*.tar.gz) — see docs/DEPLOY.md.

# 'true' = simulation only (safe default). 'false' = real orders on MT5.
HERMES_DRY_RUN=true

# Windows MT5 bridge (execution arm)
HERMES_WIN_IP=192.168.10.51
HERMES_BRIDGE_URL=http://192.168.10.51:5050
HERMES_BRIDGE_TOKEN=***

# Telegram — trading bot (reports + alerts + signal source)
TELEGRAM_BOT_TOKEN=***
TELEGRAM_CHAT_ID=194015957
TELEGRAM_SIGNAL_GROUP=-100XXXXXXXXXX

# Windows admin (for bridge deploy + off-box backup push)
WIN_USER=Administrator
WIN_PASS=

# Path to file containing the GitHub PAT used by scripts/git_sync.sh
GIT_TOKEN_FILE=/home/ai/hermes-trading/.git_token

# b37: dedicated ops/report bot (3rd bot: autopilot, health, backup, watchdog)
AUTOPILOT_REPORT_BOT_TOKEN=
AUTOPILOT_REPORT_CHAT_ID=194015957
